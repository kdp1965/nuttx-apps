#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_LISASPLASH
	tristate "NuttX on LISA splash screen (splash)"
	default n
	depends on NX && NX_BLOCKING && !NX_DISABLE_1BPP
	select NXFONTS
	select NXFONT_SANS17X23B
	select NXFONT_X11_MISC_FIXED_6X10
	---help---
		The "splash" command: a splash screen for NuttX on the LISA chip
		on Tiny Tapeout, through NX on a 1 bpp display (128x64): the Tiny
		Tapeout logo or Calvin, "NuttX" and "on LISA / Tiny / Tapeout".
		splash [tt|calvin] [seconds] - 0 seconds (the default) holds it
		until the task is killed.

if EXAMPLES_LISASPLASH

config EXAMPLES_LISASPLASH_PROGNAME
	string "Program name"
	default "splash"

config EXAMPLES_LISASPLASH_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_LISASPLASH_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

endif
