#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_OLEDTEXT
	tristate "Text on a monochrome framebuffer (oled)"
	default n
	depends on VIDEO_FB
	---help---
		The "oled" command: text in a built-in 5x7 font on a 1 bpp
		framebuffer (/dev/fb0, an SSD1306 / SSD1309 OLED through the LCD
		framebuffer): a line per argument, one line replaced (-l), double
		size (-b), clear (-c).  Only the rows it changed are sent.

if EXAMPLES_OLEDTEXT

config EXAMPLES_OLEDTEXT_PROGNAME
	string "Program name"
	default "oled"

config EXAMPLES_OLEDTEXT_DEVPATH
	string "Framebuffer device"
	default "/dev/fb0"

config EXAMPLES_OLEDTEXT_PRIORITY
	int "Task priority"
	default 100

config EXAMPLES_OLEDTEXT_STACKSIZE
	int "Stack size"
	default DEFAULT_TASK_STACKSIZE

endif
